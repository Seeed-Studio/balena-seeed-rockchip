From 3d79b7c8f2e4b5a6c7d8e9f0123456789abcde01 Mon Sep 17 00:00:00 2001
From: Seeed Studio <support@seeed.cc>
Date: Wed, 2 Sep 2026 00:00:00 +0800
Subject: [PATCH] rockchip: rk3576: boot through balena environment

The RK3576 vendor default first tries Android/Rockchip image boot paths.
Balena needs to select the flasher or active root partition and construct
the kernel command line before running distro boot, which then locates the
generated extlinux.conf.

Mirrors 0004-rk3588-balena-bootcommand.patch for the RK3576 EVB header in
the per-SoC SDK U-Boot tree at bsp/rockchip-sdk/source/u-boot-rk3576.

Upstream-Status: Inappropriate [configuration]
---
 include/configs/evb_rk3576.h | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/include/configs/evb_rk3576.h b/include/configs/evb_rk3576.h
index 1234567..7654321 100644
--- a/include/configs/evb_rk3576.h
+++ b/include/configs/evb_rk3576.h
@@ -23,1 +23,5 @@
-#define CONFIG_BOOTCOMMAND RKIMG_BOOTCOMMAND
+#define CONFIG_BOOTCOMMAND \
+    "setenv resin_kernel_load_addr ${kernel_addr_r};" \
+    "run resin_set_kernel_root;" \
+    "run set_os_cmdline;" \
+    "run distro_bootcmd;"
--
2.43.0
