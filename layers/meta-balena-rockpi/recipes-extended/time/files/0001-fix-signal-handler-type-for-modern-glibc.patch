From 4b2e9aa5e0b0b6c2df04d5a3c2b09a7d5d2b5e7f Mon Sep 17 00:00:00 2001
From: Balena Rockchip port <devnull@example.invalid>
Date: Mon, 24 Aug 2026 00:00:00 +0800
Subject: [PATCH] time: use the POSIX signal handler argument type

GNU time 1.9 declares its signal handler pointer without an argument.  With
modern glibc headers this is incompatible with signal(2), whose handler type
is void (*)(int), and GCC 15 diagnoses the assignments and calls as errors.

Use the actual POSIX handler signature.  The handlers are only saved and
restored here, so this does not change time's runtime behavior.

Upstream-Status: Inappropriate [local host-toolchain compatibility]
---
 src/time.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/time.c b/src/time.c
index 0d5b1a1..6a9f1c8 100644
--- a/src/time.c
+++ b/src/time.c
@@ -76,7 +76,7 @@
 
 
 /* A Pointer to a signal handler.  */
-typedef RETSIGTYPE (*sighandler) ();
+typedef RETSIGTYPE (*sighandler) (int);
 
 /* msec = milliseconds = 1/1,000 (1*10e-3) second.
    usec = microseconds = 1/1,000,000 (1*10e-6) second.  */
-- 
2.43.0
