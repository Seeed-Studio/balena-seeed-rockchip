# LCONF_VERSION is increased each time build/conf/bblayers.conf changes
# incompatibly. Wrynose uses the OE-Core build environment. meta-poky must
# stay: the resin-systemd distro requires poky.conf from it at parse time,
# which also sets the -poky target vendor suffix. meta-networking (with its
# meta-python dependency) provides networkmanager, dnsmasq, iptables and ppp
# that the balena image installs. meta-filesystems must stay as well: its
# aufs-util_git.bb is the only target of the aufs-util bbappend carried by
# meta-balena-common, and wrynose bitbake removed BB_DANGLINGAPPENDS_WARNONLY,
# so the orphan bbappend makes any targetless parse (bitbake -p) fatal. The
# actual trim is meta-perl, meta-arm and meta-arm-toolchain, none of which is
# referenced by any recipe in this tree.
LCONF_VERSION = "7"

BBPATH = "${TOPDIR}"
BBFILES ?= ""

BBLAYERS ?= " \
    ${TOPDIR}/../layers/meta-balena/meta-balena-rust \
    ${TOPDIR}/../layers/meta-balena/meta-balena-common \
    ${TOPDIR}/../layers/meta-balena/meta-balena-wrynose \
    ${TOPDIR}/../layers/openembedded-core/meta \
    ${TOPDIR}/../layers/meta-yocto/meta-poky \
    ${TOPDIR}/../layers/meta-openembedded/meta-oe \
    ${TOPDIR}/../layers/meta-openembedded/meta-filesystems \
    ${TOPDIR}/../layers/meta-openembedded/meta-networking \
    ${TOPDIR}/../layers/meta-openembedded/meta-python \
    ${TOPDIR}/../layers/meta-rockchip \
    ${TOPDIR}/../layers/meta-seeed-rockchip \
    ${TOPDIR}/../layers/meta-balena-rockchip \
    "
