From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Seeed Studio <support@seeed.cc>
Date: Wed, 2 Sep 2026 00:00:00 +0800
Subject: [PATCH] rockchip: rk3576: boot through balena environment

The vendor default boots through the RKIMG/Android path.  Balena needs
to select the flasher or active root partition and construct the kernel
command line before running distro boot, which then locates the
generated extlinux.conf.

Mirrors 0004-rk3588-balena-bootcommand.patch, regenerated for the radxa
next-dev-v2024.10 tree (which has a single shared header set with the
"#undef CONFIG_BOOTCOMMAND" context line).

Upstream-Status: Inappropriate [configuration]
---
diff --git a/include/configs/evb_rk3576.h b/include/configs/evb_rk3576.h
index 68ac1a0..ad35f4f 100644
--- a/include/configs/evb_rk3576.h
+++ b/include/configs/evb_rk3576.h
@@ -19,7 +19,11 @@
 #define CONFIG_SYS_MMC_ENV_DEV		0
 
 #undef CONFIG_BOOTCOMMAND
-#define CONFIG_BOOTCOMMAND	RKIMG_BOOTCOMMAND
+#define CONFIG_BOOTCOMMAND \
+    "setenv resin_kernel_load_addr ${kernel_addr_r};" \
+    "run resin_set_kernel_root;" \
+    "run set_os_cmdline;" \
+    "run distro_bootcmd;"
 
 #endif /* CONFIG_SPL_BUILD */
 #endif /* __CONFIGS_RK3576_EVB_H */
